---
import '../styles/global.scss';
import Image from 'astro/components/Image.astro';
import logo from '../images/logo.png';

interface Props {
  title: string;
  active?: 'dashboard' | 'projects' | 'community';
}

const { title, active = 'dashboard' } = Astro.props;
const navItems = [
  { key: 'dashboard', label: 'Painel', href: '/app', icon: '▦' },
  { key: 'projects', label: 'Projetos', href: '/app/projetos', icon: '♣' },
  { key: 'community', label: 'Comunidade', href: '/app/comunidade', icon: '♧' },
] as const;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
  </head>
  <body class="app-body">
    <div class="app-shell">
      <header class="app-header">
        <a href="/app" class="app-brand" aria-label="Nucarbon, painel">
          <Image src={logo} alt="" width={28} height={28} />
          <span>Nucarbon</span>
        </a>
        <div class="app-user-menu">
          <img data-user-avatar alt="" hidden />
          <span data-user-name>Carregando...</span>
          <button type="button" class="app-sign-out" data-sign-out>Sair</button>
        </div>
      </header>
      <aside class="app-sidebar" aria-label="Navegação da conta">
        <nav>
          {navItems.map((item) => (
            <a href={item.href} class:list={["app-nav-item", { active: active === item.key }]}>
              <span aria-hidden="true">{item.icon}</span>{item.label}
            </a>
          ))}
        </nav>
      </aside>
      <main class="app-main"><slot /></main>
      <nav class="app-bottom-nav" aria-label="Navegação da conta">
        {navItems.map((item) => (
          <a href={item.href} class:list={["app-bottom-link", { active: active === item.key }]}>
            <span aria-hidden="true">{item.icon}</span>{item.label}
          </a>
        ))}
      </nav>
    </div>
    <script>
      import { protectPage, signOutUser } from '../scripts/auth';
      protectPage();
      document.querySelector('[data-sign-out]')?.addEventListener('click', signOutUser);
    </script>
  </body>
</html>

<style lang="scss">
  .app-body { background: var(--app-background); }
  .app-shell { min-height: 100vh; padding-top: 65px; }
  .app-header { height: 65px; position: fixed; inset: 0 0 auto; z-index: 10; background: #fff; border-bottom: 1px solid var(--app-border); display: flex; align-items: center; justify-content: space-between; padding: 0 1.25rem; }
  .app-brand { display: flex; align-items: center; gap: .45rem; color: var(--app-green-dark); font-family: var(--font-logo); font-size: 1.25rem; font-weight: 700; }
  .app-brand :global(img) { width: 26px; height: 26px; }
  .app-user-menu { display:flex; align-items:center; gap:.5rem; color:var(--app-text-muted); font-size:.875rem; }
  .app-user-menu :global(img) { width: 30px; height:30px; border-radius: 50%; object-fit:cover; }
  .app-sign-out { border:0; background:transparent; color:var(--app-green); cursor:pointer; font:inherit; font-weight:700; }
  .app-sidebar { display:none; }
  .app-main { max-width: 1180px; margin: 0 auto; padding: 1.5rem 1.25rem 5.75rem; }
  .app-bottom-nav { position:fixed; inset:auto 0 0; z-index:10; height:64px; background:#fff; border-top:1px solid var(--app-border); display:flex; justify-content:space-around; }
  .app-bottom-link { display:flex; flex-direction:column; justify-content:center; align-items:center; gap:.2rem; min-width:76px; color:var(--app-text-muted); font-size:.7rem; font-weight:700; }
  .app-bottom-link span { font-size:1.1rem; line-height:1; }
  .app-bottom-link.active { color:var(--app-green); }
  @media (min-width: 900px) {
    .app-shell { padding-top:72px; padding-left:220px; }
    .app-header { height:72px; padding:0 2.5rem; }
    .app-sidebar { display:block; position:fixed; left:0; top:72px; bottom:0; width:220px; padding:1.5rem .75rem; background:#fff; border-right:1px solid var(--app-border); }
    .app-sidebar nav { display:grid; gap:.35rem; }
    .app-nav-item { display:flex; gap:.65rem; align-items:center; border-radius:10px; padding:.75rem 1rem; color:var(--app-text-muted); font-weight:700; }
    .app-nav-item.active, .app-nav-item:hover { background:var(--app-green-soft); color:var(--app-green-dark); }
    .app-main { padding:2.5rem; }
    .app-bottom-nav { display:none; }
  }
</style>
