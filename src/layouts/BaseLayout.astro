---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.scss';
import SiteHead from '../components/layout/SiteHead.astro';
import LoginModal from '../components/auth/LoginModal.astro';

interface Props {
  title: string;
  description?: string;
  className?: string;
  canonical?: string;
  image?: string;
  noindex?: boolean;
  transparentHeader?: boolean;
}

const {
  title,
  className,
  canonical,
  image,
  noindex = false,
  transparentHeader = false,
  description,
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <SiteHead
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      noindex={noindex}
    />
  </head>
  <body>
    <Header transparent={transparentHeader} />
    <main class={className}>
      <slot />
    </main>
    <Footer />
    <LoginModal />
  </body>
</html>
