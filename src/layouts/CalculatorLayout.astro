---
// Full-screen layout of the calculator: the step flow brings its own header,
// and the results screen renders the site header and footer.
import SiteHead from '../components/layout/SiteHead.astro';
import '../styles/global.scss';
import LoginModal from '../components/auth/LoginModal.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Calcule sua pegada de carbono e descubra maneiras de reduzir seu impacto.',
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <SiteHead title={title} description={description} />
  </head>
  <body>
    <slot />
    <LoginModal />
  </body>
</html>
