---
import BaseLayout from '../layouts/BaseLayout.astro';
import LoginForm from '../components/auth/LoginForm.astro';
---
<BaseLayout title="Entrar | Nucarbon" className="login-page"><LoginForm /></BaseLayout>
<script>
  import { authReady, signInWithGoogle } from '../scripts/auth';
  import { savePendingDraft } from '../scripts/calculator/draft';
  const user = await authReady;
  if (user) location.replace('/app');
  const form = document.querySelector<HTMLElement>('[data-login-form]')!;
  const button = form.querySelector<HTMLButtonElement>('[data-google-sign-in]')!;
  const error = form.querySelector<HTMLElement>('[data-login-error]')!;
  button.addEventListener('click', async () => {
    button.disabled = true;
    try {
      await signInWithGoogle();
      const { auth } = await import('../scripts/firebase');
      if (auth.currentUser) await savePendingDraft(auth.currentUser);
      location.assign('/app');
    } catch (cause) {
      error.textContent = cause instanceof Error ? cause.message : 'Não foi possível entrar.';
      error.hidden = false;
      button.disabled = false;
    }
  });
</script>
<style lang="scss">:global(.login-page) { min-height:75vh; display:grid; place-items:center; padding:120px 20px 60px; background:#f7f8f4; }</style>
