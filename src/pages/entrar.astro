---
import BaseLayout from '../layouts/BaseLayout.astro';
import LoginForm from '../components/auth/LoginForm.astro';
---

<BaseLayout title="Entrar | Nucarbon" noindex className="page">
  <div class="container login-page" data-login-page>
    <LoginForm headingLevel={1} />
  </div>
</BaseLayout>

<script>
  import { safeReturnTo } from '../lib/urls';
  import { currentUser } from '../scripts/auth';
  import { requireElement } from '../scripts/dom';
  import { initializeLoginForm } from '../scripts/login-modal';

  const returnTo = safeReturnTo(new URLSearchParams(location.search).get('returnTo'));

  if (await currentUser()) {
    location.replace(returnTo);
  } else {
    // BaseLayout's login modal holds a second form; use the page's own.
    const form = requireElement(document, '[data-login-page] [data-login-form]');
    initializeLoginForm(form, () => location.assign(returnTo));
  }
</script>

<style>
  .login-page {
    display: grid;
    place-items: center;
    min-height: 50vh;
  }
</style>
