---
import Card from '../../components/ui/Card.astro';
import CTA from '../../components/ui/CTA.astro';
import FeatureList from '../../components/ui/FeatureList.astro';
import CardGrid from '../../components/solutions/CardGrid.astro';
import ContentSection from '../../components/solutions/ContentSection.astro';
import SolutionPageLayout from '../../layouts/SolutionPageLayout.astro';

const courses = [
  {
    title: 'Introdução aos Créditos de Carbono',
    level: 'Básico',
    description:
      'Curso introdutório sobre o mercado de créditos de carbono, conceitos fundamentais, oportunidades e como participar de projetos.',
    topics: [
      'Conceitos básicos de créditos de carbono',
      'Mercado voluntário vs. regulado',
      'Tipos de projetos elegíveis',
      'Processo de desenvolvimento de projetos',
    ],
  },
  {
    title: 'Projetos Agroflorestais: Planejamento e Implementação',
    level: 'Intermediário',
    description:
      'Treinamento prático sobre desenvolvimento e implementação de sistemas agroflorestais, incluindo seleção de espécies, manejo e monitoramento.',
    topics: [
      'Princípios de sistemas agroflorestais',
      'Seleção e combinação de espécies',
      'Planejamento técnico e implementação',
      'Manejo e monitoramento',
    ],
  },
  {
    title: 'Elaboração de PDDs e Sistemas MRV',
    level: 'Avançado',
    description:
      'Curso técnico sobre elaboração de Documentos de Concepção de Projetos (PDD) e implementação de sistemas de Monitoramento, Relatório e Verificação (MRV).',
    topics: [
      'Estrutura e conteúdo de PDDs',
      'Metodologias de linha de base',
      'Desenvolvimento de sistemas MRV',
      'Inventários de GEE e carbono',
    ],
  },
  {
    title: 'Gestão de Riscos em Projetos de Carbono',
    level: 'Intermediário/Avançado',
    description:
      'Treinamento sobre identificação, avaliação e gestão de riscos em projetos de créditos de carbono, incluindo riscos de vazamento (leakage).',
    topics: [
      'Tipos de riscos em projetos de carbono',
      'Riscos de vazamento (leakage)',
      'Estratégias de mitigação',
      'Monitoramento e gestão contínua',
    ],
  },
];
---

<SolutionPageLayout
  title="Treinamentos - Nucarbon"
  description="Oferecemos treinamentos especializados em créditos de carbono, projetos agroflorestais e gestão sustentável. Cursos desenvolvidos por especialistas e adaptados às necessidades específicas de cada público."
  heading="Treinamentos e Capacitação"
  subtitle="Capacitação especializada em créditos de carbono e projetos sustentáveis"
>
  <ContentSection title="Nossos Programas de Treinamento">
    <p>
      A Nucarbon oferece programas de treinamento e capacitação desenvolvidos por especialistas com
      ampla experiência em créditos de carbono, projetos agroflorestais e gestão sustentável. Nossos
      cursos são adaptados às necessidades específicas de cada público, desde produtores rurais até
      profissionais técnicos e gestores.
    </p>
  </ContentSection>

  <ContentSection title="Cursos Disponíveis">
    <CardGrid columns={2}>
      {courses.map((course) => (
        <Card title={course.title}>
          <p class="course-level">Nível: {course.level}</p>
          <p>{course.description}</p>
          <FeatureList items={course.topics} marker="dot" />
        </Card>
      ))}
    </CardGrid>
  </ContentSection>

  <ContentSection title="Metodologia de Ensino" highlight>
    <p>Nossos treinamentos combinam teoria e prática, utilizando:</p>
    <FeatureList
      items={[
        'Aulas expositivas com especialistas do setor',
        'Estudos de caso reais de projetos implementados',
        'Exercícios práticos e atividades em grupo',
        'Material didático completo e atualizado',
        'Suporte pós-treinamento para dúvidas',
      ]}
    />
  </ContentSection>

  <ContentSection title="Modalidades de Treinamento">
    <CardGrid columns={2}>
      <Card title="Presencial">
        Treinamentos presenciais em locais estratégicos ou na propriedade do cliente
      </Card>
      <Card title="In-Company">Treinamentos personalizados para equipes e organizações</Card>
    </CardGrid>
  </ContentSection>

  <CTA
    title="Interessado em Nossos Treinamentos?"
    subtitle="Entre em contato para conhecer nossa programação e solicitar um orçamento personalizado."
    label="Solicitar Informações"
  />
</SolutionPageLayout>

<style lang="scss">
  .course-level {
    margin-bottom: var(--spacing-sm);
    color: var(--color-text-subtle);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
</style>
