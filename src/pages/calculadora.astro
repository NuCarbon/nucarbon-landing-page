---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import CalculatorLogo from '../components/calculator/CalculatorLogo.astro';
import CalculatorResults from '../components/calculator/CalculatorResults.astro';
import { calculatorSteps } from '../components/calculator/steps';
import { initialAnswers } from '../scripts/calculator/state';
---

<CalculatorLayout title="Calculadora de carbono | NuCarbon">
  <main class="calculator" data-calculator>
    <section class="calculator__flow" data-calculator-flow>
      <header class="calculator__header">
        <CalculatorLogo />
        <p class="calculator__step-label">Etapa <span data-current-step>1</span> de {calculatorSteps.length} <strong data-step-name>[{calculatorSteps[0].label}]</strong></p>
      </header>

      <div class="calculator__progress" aria-label="Progresso do cálculo">
        <span class="calculator__progress-value" data-progress></span>
      </div>
      <div class="calculator__dots" aria-hidden="true">
        {calculatorSteps.map(({ id }, index) => <span class:list={['calculator__dot', { 'calculator__dot--active': index === 0 }]} data-dot={id}></span>)}
      </div>

      <form class="calculator__form" data-calculator-form>
        {calculatorSteps.map(({ component: Component, label }, index) => (
          <Component answers={initialAnswers} active={index === 0} label={label} />
        ))}
      </form>

      <nav class="calculator__actions" aria-label="Navegação da calculadora">
        <button class="calculator__back" type="button" data-back>Voltar</button>
        <button class="calculator__continue" type="button" data-continue>Continuar</button>
      </nav>
    </section>

    <CalculatorResults />
  </main>
</CalculatorLayout>

<script>
  import { initializeCalculator } from '../scripts/calculator/controller';

  document.querySelectorAll<HTMLElement>('[data-calculator]').forEach(initializeCalculator);
</script>

<style lang="scss">
  .calculator {
    min-height: 100svh;

    &__flow {
      display: flex;
      flex-direction: column;
      min-height: 100svh;
      background: var(--calculator-bg);
    }

    &__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: min(100% - 3rem, 1424px);
      margin: 0 auto;
      padding: 2.7rem 0 1.65rem;
    }

    &__step-label {
      margin: 0;
      color: var(--calculator-muted);
      font-weight: 700;

      strong {
        margin-left: 0.45rem;
        color: var(--calculator-green);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      }
    }

    &__progress {
      width: min(100% - 3rem, 1424px);
      height: 6px;
      margin: 0 auto;
      overflow: hidden;
      border-radius: 10px;
      background: #dfdfda;
    }

    &__progress-value {
      display: block;
      width: 16.666%;
      height: 100%;
      border-radius: inherit;
      background: var(--calculator-green);
      transition: width 0.3s ease;
    }

    &__dots {
      display: flex;
      justify-content: center;
      gap: 7px;
      min-height: 18px;
      padding-top: 10px;
      margin-top: 12px;
    }

    &__dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #ddddda;

      &--complete { background: var(--calculator-green); }
      &--active { width: 11px; height: 11px; margin-top: -2px; background: var(--calculator-green); }
    }

    &__form {
      flex: 1;
      width: 100%;
      padding: 3.5rem 1.5rem 5rem;
    }

    &__actions {
      position: sticky;
      z-index: 5;
      bottom: 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 108px;
      padding: 1.5rem max(1.5rem, calc((100vw - 1424px) / 2));
      border-top: 1px solid #eee;
      background: #fff;
    }

    &__back,
    &__continue {
      border: 0;
      font: inherit;
      font-size: 1.05rem;
      font-weight: 700;
      cursor: pointer;
    }

    &__back { padding: 0.75rem 0; background: transparent; color: var(--calculator-muted); }

    &__continue {
      min-width: 165px;
      padding: 0.9rem 1.8rem;
      border-radius: 999px;
      background: var(--calculator-green);
      color: #fff;

      &:hover { background: var(--calculator-green-dark); }
    }
  }

  @media (max-width: 900px) {
    .calculator {
      &__header { width: calc(100% - 2rem); padding: 1.6rem 0 1.2rem; }
      &__progress { width: calc(100% - 2rem); }
      &__step-label strong { display: none; }
      &__form { padding: 2.2rem 1.25rem 4rem; }
      &__actions { min-height: 96px; padding: 1.25rem; }
    }
  }

  @media (max-width: 600px) {
    .calculator {
      &__header { padding-top: 1.5rem; }
      &__step-label { font-size: 1rem; }
      &__progress { height: 6px; }
      &__dots { padding-top: 13px; }
      &__form { padding-top: 1.9rem; }
      &__actions { min-height: 96px; }
      &__back, &__continue { font-size: 1rem; }
      &__continue { min-width: 136px; padding: 0.85rem 1.4rem; }
    }
  }
</style>
