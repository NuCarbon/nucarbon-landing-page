---
// Shown by the controller when saving the result to the account fails.
import Button from '../../ui/Button.astro';
---

<div class="save-status" data-save-error hidden>
  <p class="save-status__message" role="alert">
    Não foi possível salvar seu cálculo.
  </p>
  <Button variant="outline" size="sm" data-save-retry>
    Tentar novamente
  </Button>
</div>

<style>
  .save-status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-xs) var(--spacing-sm);
    padding: var(--spacing-sm) var(--spacing-md);
    border-radius: var(--radius-lg);
    background: var(--color-danger-soft);
  }

  .save-status__message {
    margin: 0;
    color: var(--color-danger);
    font-weight: 700;
  }
</style>
