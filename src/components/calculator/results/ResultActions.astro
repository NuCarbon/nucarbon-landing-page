---
// Actions under the result. With the projects CTA off, sharing is the main action and the
// projects link stays hidden until ?returnTo=/projetos/<slug> turns it into "Voltar ao projeto"
// (the controller then moves sharing to the secondary row).
import Button from '../../ui/Button.astro';
import ShareIcon from '../share/ShareIcon.astro';
import { features } from '../../../data/flags';
---

<div class="result-actions">
  {features.projectsCta ? (
    <>
      <Button href="/projetos" block data-projects-link>
        Conhecer projetos de restauração
      </Button>
      <div class="result-actions__secondary">
        <Button variant="outline" block data-recalculate>
          Recalcular
        </Button>
        <Button variant="outline" block data-share>
          Compartilhar
        </Button>
      </div>
    </>
  ) : (
    <>
      <Button href="/projetos" block data-projects-link hidden>
        Conhecer projetos de restauração
      </Button>
      <Button block data-share data-share-primary>
        <ShareIcon name="share" />
        Compartilhar resultado
      </Button>
      <div class="result-actions__secondary">
        <Button variant="outline" block data-recalculate>
          Recalcular
        </Button>
        <Button variant="outline" block data-share data-share-secondary hidden>
          Compartilhar
        </Button>
      </div>
    </>
  )}
</div>

<style>
  .result-actions {
    --icon-size: 1.25rem;

    display: grid;
    gap: var(--spacing-sm);
  }

  /* One column per visible action, so a lone "Recalcular" spans the row. */
  .result-actions__secondary {
    display: grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    gap: var(--spacing-sm);
  }
</style>
