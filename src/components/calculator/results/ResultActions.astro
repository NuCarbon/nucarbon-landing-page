---
import Button from '../../ui/Button.astro';
---

<div class="result-actions">
  <Button href="/projetos" block data-projects-link>
    Conhecer projetos de restauração
  </Button>
  <div class="result-actions__secondary">
    <Button variant="outline" block data-recalculate>
      Recalcular
    </Button>
    <Button variant="outline" block data-share>
      Compartilhar
    </Button>
  </div>
  <p class="result-actions__feedback" role="status" data-share-feedback></p>
</div>

<style>
  .result-actions {
    display: grid;
    gap: var(--spacing-sm);
  }

  .result-actions__secondary {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-sm);
  }

  .result-actions__feedback {
    margin: 0;
    color: var(--color-primary-dark);
    font-size: 0.875rem;
    font-weight: 700;
    text-align: center;
  }

  .result-actions__feedback:empty {
    display: none;
  }
</style>
