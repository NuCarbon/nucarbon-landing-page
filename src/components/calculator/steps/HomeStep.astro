---
import OptionCard from '../OptionCard.astro';
import { HomeAnswer, type CalculatorAnswers } from '../../../scripts/calculator/state';

interface Props {
  answers: Readonly<CalculatorAnswers>;
  active: boolean;
  label: string;
}

const { answers, active, label } = Astro.props;
---

<section class="calculator-step" data-step="home" data-step-label={label} hidden={!active} aria-labelledby="home-title">
  <h1 class="calculator-step__title" id="home-title">Como é a sua moradia?</h1>
  <div class="calculator-step__options calculator-step__options--three">
    <OptionCard group="home" value={HomeAnswer.Apartment} label="Apartamento" description="Edifício com áreas e serviços compartilhados." icon="apartment" selected={answers.home === HomeAnswer.Apartment} />
    <OptionCard group="home" value={HomeAnswer.SmallHouse} label="Casa pequena" description="Casa de até 100 m²." icon="house" selected={answers.home === HomeAnswer.SmallHouse} />
    <OptionCard group="home" value={HomeAnswer.LargeHouse} label="Casa grande" description="Casa com mais de 100 m²." icon="home" selected={answers.home === HomeAnswer.LargeHouse} />
  </div>
</section>
