---
import OptionCard from '../OptionCard.astro';
import { EnergyAnswer, type CalculatorAnswers } from '../../../lib/calculator/answers';

interface Props {
  answers: Readonly<CalculatorAnswers>;
  active: boolean;
  label: string;
}

const { answers, active, label } = Astro.props;
---

<section
  class="calculator-step"
  data-step="energy"
  data-step-label={label}
  hidden={!active}
  aria-labelledby="energy-title"
>
  <h1 class="calculator-step__title" id="energy-title">
    Qual é o seu consumo mensal de energia?
  </h1>
  <div class="calculator-step__options calculator-step__options--three">
    <OptionCard
      group="energy"
      value={EnergyAnswer.Low}
      label="Baixo"
      description="Até 150 kWh por mês."
      icon="leaf"
      selected={answers.energy === EnergyAnswer.Low}
    />
    <OptionCard
      group="energy"
      value={EnergyAnswer.Medium}
      label="Médio"
      description="Entre 150 e 300 kWh por mês."
      icon="energy"
      selected={answers.energy === EnergyAnswer.Medium}
    />
    <OptionCard
      group="energy"
      value={EnergyAnswer.High}
      label="Alto"
      description="Mais de 300 kWh por mês."
      icon="energy"
      selected={answers.energy === EnergyAnswer.High}
    />
  </div>
</section>
