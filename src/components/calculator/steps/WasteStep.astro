---
import OptionCard from '../OptionCard.astro';
import { WasteAnswer, type CalculatorAnswers } from '../../../scripts/calculator/state';

interface Props {
  answers: Readonly<CalculatorAnswers>;
  active: boolean;
  label: string;
}

const { answers, active, label } = Astro.props;
---

<section
  class="calculator-step"
  data-step="waste"
  data-step-label={label}
  hidden={!active}
  aria-labelledby="waste-title"
>
  <h1 class="calculator-step__title" id="waste-title">
    Como você lida com seus resíduos?
  </h1>
  <div class="calculator-step__options calculator-step__options--three">
    <OptionCard
      group="waste"
      value={WasteAnswer.Recycle}
      label="Reciclo sempre"
      description="Separo recicláveis e reduzo o desperdício."
      icon="leaf"
      selected={answers.waste === WasteAnswer.Recycle}
    />
    <OptionCard
      group="waste"
      value={WasteAnswer.Sometimes}
      label="Às vezes"
      description="Separo apenas alguns tipos de materiais."
      icon="bag"
      selected={answers.waste === WasteAnswer.Sometimes}
    />
    <OptionCard
      group="waste"
      value={WasteAnswer.Trash}
      label="Não separo"
      description="Descarto a maior parte no lixo comum."
      icon="trash"
      selected={answers.waste === WasteAnswer.Trash}
    />
  </div>
</section>
