---
import CalculatorIcon from './CalculatorIcon.astro';
import type { CalculatorAnswers, StepId } from '../../scripts/calculator/state';

interface Props {
  group: StepId;
  value: CalculatorAnswers[StepId];
  label: string;
  description?: string;
  icon: string;
  badge?: string;
  badgeTone?: 'green' | 'neutral' | 'warning' | 'danger';
  selected?: boolean;
  compact?: boolean;
  disabled?: boolean;
}

const {
  group,
  value,
  label,
  description,
  icon,
  badge,
  badgeTone = 'green',
  selected = false,
  compact = false,
  disabled = false,
} = Astro.props;
---

<label
  class:list={[
    'option-card',
    {
      'option-card--selected': selected,
      'option-card--compact': compact,
      'option-card--disabled': disabled,
    },
  ]}
>
  <input
    class="option-card__input"
    type="radio"
    name={group}
    value={value}
    checked={selected}
    disabled={disabled}
  />
  <span class="option-card__icon">
    <CalculatorIcon name={icon} />
  </span>
  <span class="option-card__content">
    <span class="option-card__heading">
      <span class="option-card__label">{label}</span>
      {badge && (
        <span class:list={['option-card__badge', `option-card__badge--${badgeTone}`]}>{badge}</span>
      )}
    </span>
    {description && <span class="option-card__description">{description}</span>}
  </span>
  <span class="option-card__radio" aria-hidden="true"></span>
</label>

<style lang="scss">
  .option-card {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-areas:
      'icon . radio'
      'content content content';
    align-items: center;
    gap: 1.05rem;
    min-height: 178px;
    padding: 1.7rem;
    border: 2px solid transparent;
    border-radius: 20px;
    background: #fff;
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;

    &:not(.option-card--disabled):hover {
      box-shadow: 0 8px 24px rgba(29, 62, 34, 0.07);
    }

    &--disabled {
      cursor: not-allowed;
      background: #f3f3ee;
    }

    &--disabled &__label {
      color: var(--calculator-muted);
    }

    &--selected {
      border-color: var(--calculator-green);
    }

    &__input {
      position: absolute;
      width: 1px;
      height: 1px;
      opacity: 0;
      pointer-events: none;
    }

    &__icon {
      grid-area: icon;
      display: grid;
      place-items: center;
      width: 54px;
      height: 54px;
      border-radius: 14px;
      background: #f3f3ee;
      color: #5c5d59;
    }

    &--selected &__icon {
      background: var(--calculator-green-soft);
      color: var(--calculator-green);
    }

    &__content {
      grid-area: content;
      min-width: 0;
      overflow-wrap: anywhere;
    }
    &__heading {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.6rem;
    }
    &__label {
      color: var(--calculator-ink);
      font-size: 1.15rem;
      font-weight: 700;
      line-height: 1.2;
    }

    &__description {
      display: block;
      margin-top: 0.55rem;
      color: var(--calculator-muted);
      font-family: var(--font-family-primary);
      font-size: 1rem;
      line-height: 1.45;
    }

    &__badge {
      padding: 0.18rem 0.55rem;
      border-radius: 5px;
      background: #e8f4e8;
      color: #31843b;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.75rem;
      font-weight: 700;

      &--neutral {
        background: #f2f1ea;
        color: #62625e;
      }
      &--danger {
        background: #fff0e9;
        color: #d52c22;
      }
      &--warning {
        background: #fff3cd;
        color: #856404;
      }
    }

    &__radio {
      grid-area: radio;
      justify-self: end;
      width: 13px;
      height: 13px;
      border: 2px solid #dddcd6;
      border-radius: 50%;
    }

    &--selected &__radio {
      border-color: var(--calculator-green);
      background: var(--calculator-green);
    }

    &--compact {
      align-items: center;
      min-height: 89px;
      padding: 1.25rem 1.4rem;
      border-radius: 17px;
    }

    &--compact &__icon {
      width: 45px;
      height: 45px;
      border-radius: 11px;
    }
    &--compact &__label {
      font-size: 1rem;
    }
  }
  :global(.calculator-step--food) .option-card {
    min-height: 98px;
    padding: 1.25rem 1.35rem;
  }
  :global(.calculator-step--food) .option-card__description {
    margin-top: 0.3rem;
  }

  @media (max-width: 600px) {
    .option-card {
      grid-template-areas: 'icon content radio';
      align-items: center;
      min-height: 90px;
      padding: 1rem;
      border: 1.5px solid var(--calculator-line);
      border-radius: 13px;

      &__icon {
        width: 43px;
        height: 43px;
        border-radius: 10px;
      }
      &__icon :global(.calculator-icon) {
        width: 24px;
        height: 24px;
      }
      &__label {
        font-size: 1.02rem;
      }
      &__description {
        margin-top: 0.25rem;
        font-size: 0.86rem;
        line-height: 1.35;
      }
      &__radio {
        width: 18px;
        height: 18px;
        background: transparent;
      }
      &--selected &__radio {
        border: 3px solid #fff;
        background: var(--calculator-green);
        box-shadow: 0 0 0 1px var(--calculator-green);
      }

      &--compact {
        gap: 0.4rem;
        min-height: 98px;
        padding: 0.85rem 0.75rem;
      }
      &--compact &__icon {
        width: 24px;
        height: 24px;
        background: transparent;
      }
      &--compact &__label {
        font-size: 0.95rem;
      }
      &--compact &__radio {
        width: 14px;
        height: 14px;
      }
    }
    :global(.calculator-step--food) .option-card {
      min-height: 77px;
      padding: 0.8rem;
    }
    :global(.calculator-step--food) .option-card__icon {
      width: 39px;
      height: 39px;
    }
    :global(.calculator-step--food) .option-card__heading {
      gap: 0.35rem;
    }
    :global(.calculator-step--food) .option-card__badge {
      font-size: 0.66rem;
    }
    :global(.calculator-step--food) .option-card__description {
      font-size: 0.8rem;
    }
    :global(.calculator-step--food) .option-card:last-child {
      display: none;
    }
  }
</style>
