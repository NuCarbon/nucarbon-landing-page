---
import { icons, type IconName } from './icons';

export type { IconName };

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  class:list={['calculator-icon', className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={icons[name]}
/>

<style>
  .calculator-icon {
    flex-shrink: 0;
    width: var(--icon-size, 1.75rem);
    height: var(--icon-size, 1.75rem);
  }
</style>
