---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<a class:list={['calculator-logo', { 'calculator-logo--compact': compact }]} href="/" aria-label="NuCarbon — página inicial">
  <svg class="calculator-logo__mark" viewBox="0 0 32 32" aria-hidden="true">
    <path d="M27 3.5C17.2 4.6 8.7 8.2 6.1 16.9c-1.8 6 2.1 10.7 7.8 10.7 8.7 0 13.5-9.9 13.1-24.1Z" />
    <path d="M5.2 28.8c4-7.7 9.6-12.4 17.3-16.2" />
  </svg>
  <span class="calculator-logo__text">NuCarbon</span>
</a>
