---
import { Image } from 'astro:assets';
import logo from '../../images/logo.png';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<a
  class:list={['calculator-logo', { 'calculator-logo--compact': compact }]}
  href="/"
  aria-label="Nucarbon — página inicial"
>
  <Image class="calculator-logo__mark" src={logo} alt="" width={56} height={56} />
  <span class="calculator-logo__text">Nucarbon</span>
</a>

<style lang="scss">
  .calculator-logo {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    color: var(--calculator-ink);
    font-family: var(--font-logo);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1;

    &:hover {
      color: var(--calculator-ink);
    }

    &__mark {
      width: 28px;
      height: 28px;
      flex-shrink: 0;
      filter: drop-shadow(0.5px 0 0 var(--color-bg-primary))
        drop-shadow(-0.5px 0 0 var(--color-bg-primary))
        drop-shadow(0 0.5px 0 var(--color-bg-primary))
        drop-shadow(0 -0.5px 0 var(--color-bg-primary));
    }
  }

  :global(.calculator__header),
  :global(.result__header) {
    .calculator-logo__text {
      background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
  }

  :global(.result__header) .calculator-logo {
    color: var(--calculator-green-dark);
  }
  :global(.result-footer) .calculator-logo {
    color: #fff;
  }

  @media (max-width: 600px) {
    .calculator-logo {
      gap: 0.45rem;
      font-size: 1.2rem;

      &__mark {
        width: 24px;
        height: 24px;
      }
    }

    :global(.result__header) > .calculator-logo {
      justify-self: center;
    }
  }
</style>
