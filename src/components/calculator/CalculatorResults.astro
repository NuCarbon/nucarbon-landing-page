---
import CalculatorLogo from './CalculatorLogo.astro';
import CalculatorIcon from './CalculatorIcon.astro';
import { calculateFootprint, categoryDetails, formatTonnes } from '../../lib/calculator/calculate';
import { initialAnswers } from '../../lib/calculator/answers';

const initialResult = calculateFootprint(initialAnswers);
const { categories } = initialResult;
---

<section class="result" data-result hidden>
  <header class="result__header">
    <span class="result__mobile-mark" aria-hidden="true">
      <CalculatorIcon name="leaf" />
    </span>
    <CalculatorLogo />
    <nav class="result__nav" aria-label="Navegação principal">
      <a href="/#quem-somos">Como funciona</a>
      <a href="/projetos">Projetos</a>
      <a href="/app/comunidade">Comunidade</a>
    </nav>
    <div class="result__account">
      <a href="/entrar">Entrar</a>
      <button type="button" data-recalculate>
        Calcular pegada
      </button>
    </div>
  </header>

  <div class="result__main">
    <div class="result__summary">
      <p class="result__eyebrow">Cálculo concluído</p>
      <h1 class="result__title">Sua pegada de carbono estimada</h1>
      <div class="result__save" data-save-error hidden>
        <p role="alert">Não foi possível salvar seu cálculo.</p>
        <button type="button" data-save-retry>
          Tentar novamente
        </button>
      </div>
      <section class="result-total" aria-label="Pegada total estimada">
        <span class="result-total__icon">
          <CalculatorIcon name="tree" />
        </span>
        <div>
          <p class="result-total__number">
            <strong data-total>{formatTonnes(initialResult.total)}</strong> tCO₂e / ano
          </p>
          <p class="result-total__trees">
            ≈ <span data-trees>{initialResult.trees.toLocaleString('pt-BR')}</span> árvores em
            equivalência ilustrativa à sua pegada anual
          </p>
        </div>
      </section>

      <section class="result-breakdown">
        <h2 class="result-breakdown__title">
          Distribuição <span class="result-breakdown__desktop-word">por Categoria</span>
          <span class="result-breakdown__mobile-word">estimada</span>
        </h2>
        {categories.map((category) => (
          <div class="result-breakdown__item" data-category={category.id}>
            <div class="result-breakdown__label">
              <>
                <strong>{categoryDetails[category.id].label}</strong>
                <span data-category-value>{formatTonnes(category.tonnes)} tCO₂e</span>
              </>
            </div>
            <div class="result-breakdown__track">
              <span
                data-category-bar
                class:list={[
                  'result-breakdown__bar',
                  {
                    'result-breakdown__bar--danger': category.id === initialResult.tips[0]?.id,
                  },
                ]}
                style={`--bar-width:${category.percentage}%`}
              />
            </div>
          </div>
        ))}
      </section>
    </div>

    <aside class="result__insights">
      <section class="result-alert">
        <span class="result-alert__icon">!</span>
        <div>
          <h2 data-attention-title>{initialResult.attention.title}</h2>
          <p data-attention-description>{initialResult.attention.description}</p>
        </div>
      </section>
      <section class="result-tips" data-tips-section>
        <h2>Como reduzir sua pegada</h2>
        <div class="result-tips__list" data-tips-list>
          {[...categories]
            .sort((a, b) => b.tonnes - a.tonnes)
            .map((category) => {
              const tip = initialResult.tips.find((item) => item.id === category.id);
              return (
                <article class="result-tip" data-tip={category.id} hidden={!tip}>
                  <span>
                    <CalculatorIcon name={categoryDetails[category.id].icon} />
                  </span>
                  <div>
                    <>
                      <h3 data-tip-title>{tip?.title}</h3>
                      <p data-tip-description>{tip?.description}</p>
                    </>
                  </div>
                </article>
              );
            })}
        </div>
      </section>
      <a class="result__projects" href="/projetos">
        Conhecer projetos de restauração
      </a>
      <div class="result__secondary-actions">
        <button type="button" data-recalculate>
          Recalcular
        </button>
        <button type="button" data-share>
          Compartilhar <span class="result__desktop-word">resultado</span>
        </button>
      </div>
      <p class="result__note">
        <span>
          <CalculatorIcon name="info" />
        </span>
        Estimativa baseada em fatores médios. Os valores e a equivalência em árvores não representam
        uma medição validada.
      </p>
    </aside>
  </div>

  <footer class="result-footer">
    <div class="result-footer__brand">
      <CalculatorLogo />
      <p>
        Acelerando a transição ecológica brasileira por meio de tecnologia, dados científicos e
        restauração ecológica de nossos biomas originais.
      </p>
    </div>
    <div class="result-footer__links">
      <div>
        <strong>Plataforma</strong>
        <a href="/#quem-somos">Como funciona</a>
        <a href="/calculadora">Calculadora</a>
        <a href="/projetos">Projetos ativos</a>
      </div>
      <div>
        <strong>Recursos</strong>
        <a href="/#faq">Metodologia</a>
        <a href="/#contato">Blog</a>
        <a href="/#creditos-carbono">Relatórios tCO₂e</a>
      </div>
      <div>
        <strong>Contato</strong>
        <a href="/#contato">Suporte</a>
        <a href="/#contato">Parcerias B2B</a>
        <a href="/#contato">Fale conosco</a>
      </div>
    </div>
    <p class="result-footer__copyright">© 2026 NuCarbon S.A. Todos os direitos reservados.</p>
  </footer>
</section>

<style lang="scss">
  .result__save {
    margin-bottom: 1.5rem;
    color: var(--calculator-muted);

    p {
      margin: 0 0 0.5rem;
    }
    button {
      border: 0;
      border-radius: 999px;
      padding: 0.7rem 1rem;
      background: var(--calculator-green);
      color: #fff;
      font: inherit;
      cursor: pointer;
    }
  }

  .result {
    min-height: 100svh;
    background: var(--calculator-bg);

    &__header {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 2rem;
      min-height: 88px;
      padding: 1rem max(2rem, calc((100vw - 1424px) / 2));
      border-bottom: 1px solid #f0f0ec;
      background: #fff;
    }

    &__mobile-mark {
      display: none;
    }

    &__nav {
      display: flex;
      gap: 3rem;
      a {
        color: var(--calculator-muted);
        font-weight: 700;
      }
    }

    &__account {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 1.5rem;

      a {
        color: var(--calculator-ink);
        font-weight: 700;
      }
      button {
        padding: 0.8rem 1.5rem;
        border: 0;
        border-radius: 99px;
        background: var(--calculator-green);
        color: #fff;
        font: inherit;
        font-weight: 700;
        cursor: pointer;
      }
    }

    &__main {
      display: grid;
      grid-template-columns: minmax(0, 1.3fr) minmax(420px, 0.95fr);
      gap: 3.3rem;
      width: min(100% - 3rem, 1424px);
      margin: 0 auto;
      padding: 5.5rem 0 7.5rem;
    }

    &__eyebrow {
      margin: 0 0 0.8rem;
      color: var(--calculator-green);
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.85rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
    &__title {
      margin: 0 0 2.4rem;
      color: var(--calculator-ink);
      font-size: clamp(2rem, 3vw, 2.5rem);
      letter-spacing: -0.035em;
    }
    &__insights {
      display: flex;
      flex-direction: column;
      gap: 1.65rem;
      padding-top: 1.8rem;
    }

    &__projects {
      display: block;
      padding: 1rem 1.5rem;
      border-radius: 12px;
      background: var(--calculator-green);
      color: #fff;
      font-weight: 700;
      text-align: center;
      &:hover {
        background: var(--calculator-green-dark);
        color: #fff;
      }
    }

    &__secondary-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.8rem;
      margin-top: -0.9rem;
      button {
        padding: 1rem;
        border: 0;
        border-radius: 12px;
        background: #fff;
        color: var(--calculator-muted);
        font: inherit;
        font-weight: 700;
        cursor: pointer;
      }
    }

    &__note {
      display: flex;
      align-items: center;
      gap: 0.7rem;
      margin: 0;
      padding: 1rem;
      border-radius: 10px;
      background: #f5f5ef;
      color: var(--calculator-muted);
      font-family: var(--font-family-primary);
      font-size: 0.8rem;
      line-height: 1.35;
      span {
        display: flex;
        flex: 0 0 auto;
      }
      :global(.calculator-icon) {
        width: 18px;
        height: 18px;
      }
    }
    &__mobile-word {
      display: none;
    }
  }

  .result-total {
    display: flex;
    align-items: center;
    gap: 2.2rem;
    min-height: 166px;
    padding: 2rem 2.2rem;
    border-radius: 28px;
    background: var(--calculator-green-soft);
    color: var(--calculator-green-dark);

    &__icon {
      display: grid;
      place-items: center;
      flex: 0 0 90px;
      width: 90px;
      height: 90px;
      border-radius: 50%;
      background: #fff;
      :global(.calculator-icon) {
        width: 44px;
        height: 44px;
      }
    }
    &__number {
      margin: 0;
      color: inherit;
      font-size: 1.8rem;
      font-weight: 700;
      strong {
        font-size: 3.4rem;
      }
    }
    &__trees {
      margin: 0.35rem 0 0;
      color: var(--calculator-green);
      font-size: 1.1rem;
      font-weight: 700;
    }
  }

  .result-breakdown {
    margin-top: 2.2rem;
    padding: 2.3rem;
    border-radius: 20px;
    background: #fff;

    &__title {
      margin: 0 0 1.7rem;
      color: var(--calculator-ink);
      font-size: 1.4rem;
    }
    &__mobile-word {
      display: none;
    }
    &__item + &__item {
      margin-top: 1.15rem;
    }
    &__label {
      display: flex;
      justify-content: space-between;
      margin-bottom: 0.5rem;
      color: var(--calculator-ink);
      span {
        color: var(--calculator-muted);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      }
    }
    &__track {
      height: 11px;
      overflow: hidden;
      border-radius: 99px;
      background: #f0f0eb;
    }
    &__bar {
      display: block;
      width: var(--bar-width);
      height: 100%;
      background: var(--calculator-green);
    }
    &__bar--danger {
      background: #d72b28;
    }
    &__bar--light {
      background: #4caf50;
    }
  }

  .result-alert {
    display: flex;
    gap: 1.2rem;
    padding: 2rem 1.8rem;
    border-radius: 20px;
    background: #fff7dd;
    color: #68483f;

    &__icon {
      display: grid;
      place-items: center;
      flex: 0 0 26px;
      width: 26px;
      height: 26px;
      border: 2px solid #ff7f11;
      border-radius: 50%;
      color: #ff7f11;
      font-weight: 800;
    }
    h2 {
      margin: 0 0 0.35rem;
      color: inherit;
      font-size: 1.15rem;
    }
    p {
      margin: 0;
      color: inherit;
      font-family: var(--font-family-primary);
      line-height: 1.45;
    }
  }

  .result-tips {
    padding: 2rem;
    border-radius: 20px;
    background: #fff;

    > h2 {
      margin: 0 0 1.4rem;
      color: var(--calculator-ink);
      font-size: 1.35rem;
    }
    &__list {
      display: grid;
      gap: 1.15rem;
    }
  }

  .result-tip {
    display: flex;
    align-items: flex-start;
    gap: 1rem;

    > span {
      display: flex;
      flex: 0 0 22px;
      color: var(--calculator-green);
    }
    :global(.calculator-icon) {
      width: 22px;
      height: 22px;
    }
    h3 {
      margin: 0 0 0.15rem;
      color: var(--calculator-ink);
      font-size: 1rem;
    }
    p {
      margin: 0;
      color: var(--calculator-muted);
      font-family: var(--font-family-primary);
      font-size: 0.9rem;
      line-height: 1.4;
    }
  }

  .result-footer {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 5rem;
    padding: 5.5rem max(2rem, calc((100vw - 1424px) / 2)) 2.5rem;
    background: #176528;
    color: #fff;

    &__brand p {
      max-width: 440px;
      margin: 1.5rem 0 0;
      color: rgba(255, 255, 255, 0.78);
      font-family: var(--font-family-primary);
      line-height: 1.6;
    }
    &__links {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
      div {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }
      strong {
        color: #5bb45e;
        text-transform: uppercase;
      }
      a {
        color: rgba(255, 255, 255, 0.78);
      }
    }
    &__copyright {
      grid-column: 1 / -1;
      margin: 1rem 0 0;
      padding-top: 2rem;
      border-top: 1px solid rgba(255, 255, 255, 0.16);
      color: rgba(255, 255, 255, 0.75);
    }
  }

  @media (max-width: 900px) {
    .result {
      &__header {
        grid-template-columns: 1fr auto;
        padding: 1rem 1.2rem;
      }
      &__nav {
        display: none;
      }
      &__main {
        grid-template-columns: 1fr;
        width: min(100% - 2.5rem, 680px);
        padding: 3rem 0 5rem;
      }
      &__insights {
        padding-top: 0;
      }
    }
  }

  @media (max-width: 600px) {
    .result {
      &__header {
        grid-template-columns: 1fr auto 1fr;
        min-height: 64px;
        padding: 0.7rem 1.15rem;
      }
      &__mobile-mark {
        display: flex;
        color: var(--calculator-green-dark);
        :global(.calculator-icon) {
          width: 25px;
          height: 25px;
          fill: currentColor;
        }
      }

      &__account {
        justify-self: end;
      }
      &__account a {
        display: none;
      }
      &__account button {
        padding: 0.65rem 1.1rem;
        font-size: 0.85rem;
      }
      &__main {
        gap: 1.35rem;
        width: calc(100% - 2rem);
        padding: 2rem 0 3.5rem;
      }
      &__eyebrow {
        font-size: 0.75rem;
      }
      &__title {
        margin-bottom: 1.6rem;
        font-size: 1.8rem;
      }
      &__insights {
        gap: 1.3rem;
      }
      &__desktop-word {
        display: none;
      }
      &__mobile-word {
        display: inline;
      }
      &__projects {
        padding: 0.9rem 1rem;
      }
      &__note {
        font-size: 0.73rem;
      }
    }
  }

  @media (max-width: 600px) {
    .result-total {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 1rem;
      min-height: 0;
      padding: 1.6rem 1.25rem;
      border-radius: 18px;

      &__icon {
        width: 58px;
        height: 58px;
        flex-basis: 58px;
        :global(.calculator-icon) {
          width: 31px;
          height: 31px;
        }
      }
      &__number {
        font-size: 1.25rem;
        white-space: nowrap;
        strong {
          font-size: 2.45rem;
        }
      }
      &__trees {
        grid-column: 1 / -1;
        margin: 0;
        font-size: 0.95rem;
      }
      > div {
        display: contents;
      }
    }
  }

  @media (max-width: 600px) {
    .result-breakdown {
      margin-top: 1.35rem;
      padding: 1.25rem;
      border: 1px solid var(--calculator-line);
      border-radius: 14px;

      &__title {
        margin-bottom: 1.25rem;
        font-size: 1.15rem;
      }
      &__desktop-word {
        display: none;
      }
      &__mobile-word {
        display: inline;
      }
      &__label {
        font-size: 0.9rem;
      }
      &__track {
        height: 7px;
      }
    }
  }

  @media (max-width: 600px) {
    .result-alert {
      padding: 1.25rem;
      border: 1px solid #e8dfc6;
      border-radius: 14px;
      h2 {
        font-size: 1rem;
      }
      p {
        font-size: 0.88rem;
      }
    }
  }

  @media (max-width: 600px) {
    .result-tips {
      padding: 0;
      background: transparent;
      > h2 {
        font-size: 1.2rem;
      }
    }
  }

  @media (max-width: 600px) {
    .result-tip {
      padding: 1.1rem;
      border: 1px solid var(--calculator-line);
      border-radius: 14px;
      background: #fff;
      h3 {
        font-size: 0.95rem;
      }
      p {
        font-size: 0.83rem;
      }
      &--desktop {
        display: none;
      }
    }
  }

  @media (max-width: 600px) {
    .result-footer {
      display: none;
    }
  }
</style>
