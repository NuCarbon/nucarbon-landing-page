---
import type { Project } from '../../types/app';
const { project } = Astro.props as { project: Project };
const metrics = [
  ['Área do projeto', `${project.areaHectares.toLocaleString('pt-BR')} hectares`],
  ['Árvores plantadas', project.treesPlanted.toLocaleString('pt-BR')],
  ['Carbono estimado', `${project.carbonTonnes.toLocaleString('pt-BR')} tCO₂e`],
  ['Participantes', project.participants.toLocaleString('pt-BR')],
];
---
<div class="metrics">{metrics.map(([label, value]) => <div><span>{label}</span><strong>{value}</strong></div>)}</div>
<style lang="scss">
  .metrics { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:12px; margin:20px 0 34px; }
  .metrics>div { padding:18px; border-radius:14px; background:white; }
  span { display:block; color:#657064; font-size:.8rem; }
  strong { display:block; margin-top:6px; color:#236d32; font-size:1.15rem; }
  @media(max-width:650px) { .metrics { grid-template-columns:repeat(2,minmax(0,1fr)); } }
</style>
