---
import type { Project } from '../../types/app';
const { project } = Astro.props as { project: Project };
---

<div class="gallery" data-gallery>
  <img
    class="hero"
    src={project.gallery[0]?.url}
    alt={project.gallery[0]?.alt ?? project.name}
    data-gallery-main
  />
  <div class="thumbs" aria-label="Imagens do projeto">
    {project.gallery.map((image, index) => (
      <button
        type="button"
        data-gallery-thumb
        data-url={image.url}
        data-alt={image.alt}
        aria-label={`Ver imagem ${index + 1}`}
        aria-pressed={index === 0}
      >
        <img src={image.url} alt="" loading="lazy" />
      </button>
    ))}
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const main = gallery.querySelector<HTMLImageElement>('[data-gallery-main]')!;
    gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]').forEach((button) =>
      button.addEventListener('click', () => {
        main.src = button.dataset.url!;
        main.alt = button.dataset.alt!;
        gallery
          .querySelectorAll('[data-gallery-thumb]')
          .forEach((other) => other.setAttribute('aria-pressed', String(other === button)));
      }),
    );
  });
</script>
<style lang="scss">
  .hero {
    display: block;
    width: 100%;
    aspect-ratio: 16/9;
    object-fit: cover;
    border-radius: 20px;
    background: #dbe9dc;
  }
  .thumbs {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    padding: 12px 0;
  }
  button {
    flex: 0 0 100px;
    padding: 0;
    border: 3px solid transparent;
    border-radius: 10px;
    overflow: hidden;
    background: none;
    cursor: pointer;
  }
  button[aria-pressed='true'],
  button:focus-visible {
    border-color: #287739;
  }
  button img {
    display: block;
    width: 100%;
    height: 65px;
    object-fit: cover;
  }
</style>
