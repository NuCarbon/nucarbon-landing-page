---
// Shown in place of project content: no projects yet, project not found, or Firestore down.
import Button from '../ui/Button.astro';

interface Props {
  title: string;
  message: string;
  headingLevel?: 1 | 2;
  /** Adds a link back to the project list. */
  showProjectsLink?: boolean;
}

const { title, message, headingLevel = 2, showProjectsLink = false } = Astro.props;
const Heading = `h${headingLevel}` as 'h1' | 'h2';
---

<section class="notice surface">
  <Heading class="notice__title">{title}</Heading>
  <p class="notice__message">{message}</p>
  {showProjectsLink && <Button href="/projetos">Ver projetos</Button>}
</section>

<style>
  .notice {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-xs);
    padding: var(--spacing-xl) var(--spacing-md);
    text-align: center;
  }

  .notice__title {
    margin: 0;
    font-size: clamp(1.375rem, 3vw, 1.75rem);
  }

  .notice__message {
    max-width: 32rem;
    margin: 0 0 var(--spacing-xs);
  }
</style>
