---
import type { Project } from '../../types/app';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { gallery } = project;
const [cover] = gallery;
---

<div class="gallery" data-gallery>
  {cover ? (
    <img
      class="gallery__main"
      data-gallery-main
      src={cover.url}
      alt={cover.alt}
      width="1280"
      height="720"
      decoding="async"
      fetchpriority="high"
    />
  ) : (
    <div class="gallery__main gallery__placeholder" aria-hidden="true" />
  )}

  {gallery.length > 1 && (
    <div class="gallery__thumbs" role="group" aria-label="Imagens do projeto">
      {gallery.map((image, index) => (
        <button
          type="button"
          class="gallery__thumb"
          data-gallery-thumb
          data-url={image.url}
          data-alt={image.alt}
          aria-label={`Ver imagem ${index + 1} de ${gallery.length}: ${image.alt}`}
          aria-pressed={index === 0 ? 'true' : 'false'}
        >
          <img src={image.url} alt="" width="160" height="100" loading="lazy" decoding="async" />
        </button>
      ))}
    </div>
  )}
</div>

<script>
  import { initializeGallery } from '../../scripts/projects/gallery';

  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach(initializeGallery);
</script>

<style>
  .gallery__main {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-lg);
    background: var(--color-surface-muted);
  }

  .gallery__placeholder {
    background: linear-gradient(135deg, var(--color-primary-dark), var(--color-primary));
  }

  .gallery__thumbs {
    display: flex;
    gap: var(--spacing-xs);
    margin-top: var(--spacing-xs);
    padding: var(--spacing-2xs);
    overflow-x: auto;
  }

  .gallery__thumb {
    flex: 0 0 6rem;
    padding: 0;
    overflow: hidden;
    border: 2px solid transparent;
    border-radius: var(--radius-sm);
    background: var(--color-surface-muted);
    cursor: pointer;
    opacity: 0.75;
    transition:
      border-color var(--transition-fast),
      opacity var(--transition-fast);
  }

  .gallery__thumb:hover,
  .gallery__thumb[aria-pressed='true'] {
    opacity: 1;
  }

  .gallery__thumb[aria-pressed='true'] {
    border-color: var(--color-primary);
  }

  .gallery__thumb img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 8 / 5;
    object-fit: cover;
  }
</style>
