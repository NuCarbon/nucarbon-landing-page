---
import type { Project } from '../../types/app';
const { project } = Astro.props as { project: Project };
const mapUrl = `https://www.openstreetmap.org/export/embed.html?bbox=${project.location.longitude-.03}%2C${project.location.latitude-.03}%2C${project.location.longitude+.03}%2C${project.location.latitude+.03}&layer=mapnik&marker=${project.location.latitude}%2C${project.location.longitude}`;
---
<nav class="sections-nav" aria-label="Seções do projeto"><a href="#sobre">Sobre</a><a href="#especies">Espécies</a><a href="#impactos">Impactos</a><a href="#linha-do-tempo">Linha do tempo</a><a href="#metodologia">Metodologia</a><a href="#documentos">Documentos</a></nav>
<div class="sections">
  <section id="sobre"><h2>Sobre o projeto</h2><p>{project.description}</p></section>
  <section id="especies"><h2>Espécies nativas</h2>{project.species.length ? <ul class="cards">{project.species.map((species) => <li><strong>{species.name}</strong><small>{species.scientificName}</small></li>)}</ul> : <p>Espécies ainda não informadas.</p>}</section>
  <section><h2>Localização</h2><p>{project.municipality}, {project.state}. O marcador indica a coordenada cadastrada do projeto.</p><iframe title={`Mapa de ${project.name}`} src={mapUrl} loading="lazy" referrerpolicy="no-referrer" /></section>
  <section id="impactos"><h2>Impactos adicionais</h2>{project.impacts.length ? <ul class="cards">{project.impacts.map((impact) => <li><strong>{impact.title}</strong><p>{impact.description}</p></li>)}</ul> : <p>Impactos adicionais ainda não informados.</p>}</section>
  <section id="linha-do-tempo"><h2>Linha do tempo</h2>{project.timeline.length ? <ul>{project.timeline.map((event) => <li><strong>{event.label}</strong> — {event.description}</li>)}</ul> : <p>Marcos do projeto ainda não informados.</p>}</section>
  <section id="metodologia"><h2>Metodologia</h2><p>{project.methodology}</p></section>
  <section id="documentos"><h2>Documentos</h2>{project.documents.length ? <ul>{project.documents.map((document) => <li><a href={document.url} target="_blank" rel="noopener noreferrer">{document.title}</a></li>)}</ul> : <p>Documentos ainda não disponíveis.</p>}</section>
</div>
<style lang="scss">
  .sections-nav { display:flex; gap:24px; overflow-x:auto; white-space:nowrap; border-bottom:1px solid #dce4d9; padding:12px 0; }
  .sections-nav a { color:#345d38; text-decoration:none; font-weight:700; }
  .sections-nav a:hover,.sections-nav a:focus-visible { text-decoration:underline; }
  .sections section { scroll-margin-top:110px; padding:20px 0; }
  h2 { font-size:1.25rem; color:#202c22; }
  p,li { line-height:1.65; }
  .cards { display:grid; grid-template-columns:repeat(auto-fit,minmax(175px,1fr)); gap:12px; padding:0; list-style:none; }
  .cards li { padding:16px; background:white; border-radius:12px; }
  small { display:block; color:#667; font-style:italic; }
  iframe { width:100%; height:280px; border:0; border-radius:14px; }
</style>
