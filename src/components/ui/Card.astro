---
import type { HTMLAttributes } from 'astro/types';

/** Any of the components in components/icons. */
type IconComponent = (props: HTMLAttributes<'svg'>) => unknown;

interface Props {
  title?: string;
  /** Heading level of the title; pick the one that follows the surrounding heading. */
  level?: 2 | 3 | 4;
  icon?: IconComponent;
  /** Turns the whole card into a link with a "Saiba mais" call to action. */
  href?: string;
  align?: 'start' | 'center';
  class?: string;
}

const { title, level = 3, icon: Icon, href, align = 'start', class: className } = Astro.props;
const Heading = `h${level}` as const;
---

<div
  class:list={['feature-card', `feature-card--${align}`, { 'feature-card--link': href }, className]}
>
  {Icon && <Icon class="feature-card__icon" />}
  {title && <Heading class="feature-card__title">{title}</Heading>}
  <div class="feature-card__body">
    <slot />
  </div>
  {href && (
    <a href={href} class="feature-card__link">
      Saiba mais
      {title && <span class="visually-hidden">sobre {title}</span>}
      <span aria-hidden="true">→</span>
    </a>
  )}
</div>

<style lang="scss">
  @use '../../styles/mixins' as mx;

  .feature-card {
    @include mx.surface;
    position: relative;
    display: flex;
    flex-direction: column;
    padding: var(--spacing-md);
    box-shadow: var(--shadow-sm);

    @include mx.up(md) {
      padding: var(--spacing-lg);
    }
  }

  .feature-card--center {
    align-items: center;
    text-align: center;
  }

  .feature-card--link {
    transition:
      transform var(--transition-base),
      box-shadow var(--transition-base),
      border-color var(--transition-base);

    &:hover,
    &:focus-within {
      border-color: var(--color-primary-tint);
      box-shadow: var(--shadow-card);
      transform: translateY(-4px);
    }

    @include mx.reduced-motion {
      &:hover,
      &:focus-within {
        transform: none;
      }
    }
  }

  .feature-card__icon {
    width: 3.5rem;
    height: 3.5rem;
    margin-bottom: var(--spacing-md);
    padding: var(--spacing-sm);
    border-radius: var(--radius-md);
    background-color: var(--color-primary-soft);
    color: var(--color-primary);
  }

  .feature-card__title {
    margin-bottom: var(--spacing-sm);
    font-size: 1.25rem;
  }

  .feature-card__body {
    flex: 1;
    color: var(--color-text-muted);

    > :global(:last-child) {
      margin-bottom: 0;
    }
  }

  .feature-card__link {
    align-self: stretch;
    margin-top: var(--spacing-md);
    padding-top: var(--spacing-md);
    border-top: 1px solid var(--color-border);
    font-weight: 600;

    // Stretches the click target over the whole card.
    &::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: var(--radius-lg);
    }

    &:focus-visible {
      outline: none;

      &::after {
        @include mx.focus-ring;
      }
    }
  }
</style>
