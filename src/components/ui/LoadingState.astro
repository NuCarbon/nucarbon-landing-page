---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<div class="loading-state" data-app-loading role="status" aria-live="polite">
  <span class="visually-hidden">{label}</span>
  <slot />
</div>

<style>
  .loading-state {
    width: 100%;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
