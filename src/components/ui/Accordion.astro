---
interface AccordionItem {
  question: string;
  answer: string;
  /** Shown after the answer, e.g. a page that goes deeper. */
  link?: { label: string; href: string };
}

interface Props {
  items: AccordionItem[];
  /** Items sharing a name are exclusive: opening one closes the others. */
  name: string;
}

const { items, name } = Astro.props;
---

<div class="accordion">
  {items.map((item) => (
    <details class="accordion__item" name={name}>
      <summary class="accordion__summary">
        <span class="accordion__question">{item.question}</span>
        <span class="accordion__icon" aria-hidden="true" />
      </summary>
      <p class="accordion__answer">{item.answer}</p>
      {item.link && (
        <p class="accordion__link">
          <a href={item.link.href}>
            {item.link.label} <span aria-hidden="true">→</span>
          </a>
        </p>
      )}
    </details>
  ))}
</div>

<style lang="scss">
  .accordion {
    display: grid;
    gap: var(--spacing-md);
  }

  .accordion__item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-bg);
  }

  .accordion__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-sm);
    padding: var(--spacing-md);
    border-radius: var(--radius-lg);
    list-style: none;
    cursor: pointer;

    &::-webkit-details-marker {
      display: none;
    }

    &:hover .accordion__question {
      color: var(--color-primary);
    }
  }

  .accordion__question {
    flex: 1;
    color: var(--color-text);
    font-size: 1.125rem;
    font-weight: 600;
    transition: color var(--transition-base);
  }

  // A plus sign drawn with two bars; the vertical one collapses into a minus when open.
  .accordion__icon {
    position: relative;
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
    color: var(--color-primary);

    &::before,
    &::after {
      content: '';
      position: absolute;
      inset: calc(50% - 1px) 0 auto;
      height: 2px;
      border-radius: var(--radius-pill);
      background-color: currentColor;
      transition: transform var(--transition-base);
    }

    &::after {
      transform: rotate(90deg);
    }

    .accordion__item[open] &::after {
      transform: rotate(0deg);
    }
  }

  .accordion__answer {
    margin: 0;
    padding: 0 var(--spacing-md) var(--spacing-md);

    &:has(+ .accordion__link) {
      padding-bottom: var(--spacing-xs);
    }
  }

  .accordion__link {
    margin: 0;
    padding: 0 var(--spacing-md) var(--spacing-md);
    font-weight: 600;

    a:hover {
      text-decoration: underline;
    }
  }
</style>
