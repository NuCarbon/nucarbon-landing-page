---
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'outline' | 'ghost' | 'primary-inverse' | 'outline-inverse';
type Size = 'sm' | 'md' | 'lg';

interface Common {
  variant?: Variant;
  size?: Size;
  /** Stretches to the container width. */
  block?: boolean;
  class?: string;
}

/** Renders a link when `href` is set, otherwise a `type="button"` button. Other attributes pass through. */
type Props =
  | (Common & Omit<HTMLAttributes<'a'>, 'class'> & { href: string })
  | (Common & Omit<HTMLAttributes<'button'>, 'class'> & { href?: undefined });

const {
  variant = 'primary',
  size = 'md',
  block = false,
  class: className,
  ...attributes
} = Astro.props;
const classes = ['btn', `btn--${variant}`, `btn--${size}`, { 'btn--block': block }, className];
const { type = 'button', ...buttonAttributes } = attributes as HTMLAttributes<'button'>;
---

{'href' in attributes && attributes.href !== undefined ? (
  <a class:list={classes} {...(attributes as HTMLAttributes<'a'>)}>
    <slot />
  </a>
) : (
  <button class:list={classes} type={type} {...buttonAttributes}>
    <slot />
  </button>
)}

<style lang="scss">
  @use '../../styles/mixins' as mx;

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-xs);
    border: 2px solid transparent;
    border-radius: var(--radius-pill);
    font: inherit;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--transition-base),
      border-color var(--transition-base),
      color var(--transition-base);

    &:disabled,
    &[aria-disabled='true'] {
      cursor: not-allowed;
      opacity: 0.55;
    }

    &:focus-visible {
      @include mx.focus-ring;
    }
  }

  .btn--sm {
    padding: 0.45rem 1rem;
    font-size: 0.875rem;
  }

  .btn--md {
    padding: 0.75rem 1.5rem;
    font-size: 1rem;
  }

  .btn--lg {
    padding: 0.95rem 2rem;
    font-size: 1.0625rem;
  }

  .btn--block {
    display: flex;
    width: 100%;
  }

  .btn--primary {
    background-color: var(--color-primary);
    color: var(--color-on-primary);

    &:hover:not(:disabled) {
      background-color: var(--color-primary-dark);
      color: var(--color-on-primary);
    }
  }

  .btn--outline {
    background-color: transparent;
    border-color: var(--color-primary);
    color: var(--color-primary);

    &:hover:not(:disabled) {
      background-color: var(--color-primary-soft);
      color: var(--color-primary-dark);
    }
  }

  .btn--ghost {
    background-color: transparent;
    color: var(--color-text-muted);

    &:hover:not(:disabled) {
      background-color: var(--color-surface-muted);
      color: var(--color-text);
    }
  }

  .btn--primary-inverse {
    background-color: var(--color-surface);
    color: var(--color-primary-dark);

    &:hover:not(:disabled) {
      background-color: var(--color-primary-soft);
      color: var(--color-primary-dark);
    }
  }

  .btn--outline-inverse {
    background-color: transparent;
    border-color: var(--color-on-dark);
    color: var(--color-on-dark);

    &:hover:not(:disabled) {
      background-color: var(--color-on-dark);
      color: var(--color-primary-dark);
    }
  }
</style>
