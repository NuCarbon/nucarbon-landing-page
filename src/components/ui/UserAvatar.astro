---
// Filled in the browser by scripts/user-display.ts (photo, or the name's initial).
interface Props {
  size?: number;
  class?: string;
}

const { size = 32, class: className, ...attributes } = Astro.props;
---

<span
  class:list={['user-avatar', className]}
  style={`--avatar-size: ${size}px`}
  aria-hidden="true"
  {...attributes}
>
  <img data-user-avatar alt="" width={size} height={size} referrerpolicy="no-referrer" hidden />
  <span data-user-initial hidden></span>
</span>

<style>
  .user-avatar {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: var(--avatar-size);
    height: var(--avatar-size);
    overflow: hidden;
    border-radius: var(--radius-round);
    background: var(--color-primary-soft);
    color: var(--color-primary-dark);
    font-size: calc(var(--avatar-size) * 0.45);
    font-weight: 700;
    line-height: 1;
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
