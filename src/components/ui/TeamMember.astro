---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  name: string;
  /** One role per line. */
  role: string | string[];
}

const { image, name, role } = Astro.props;
const roles = Array.isArray(role) ? role : [role];
---

<article class="team-member">
  <Image
    src={image}
    alt={`Foto de ${name}`}
    width={300}
    densities={[1, 2]}
    class="team-member__photo"
  />
  <div class="team-member__content">
    <h3 class="team-member__name">{name}</h3>
    <ul class="team-member__roles">
      {roles.map((value) => (
        <li>{value}</li>
      ))}
    </ul>
  </div>
</article>

<style lang="scss">
  @use '../../styles/mixins' as mx;

  .team-member {
    @include mx.surface;
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 300px;
    margin: 0 auto;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    text-align: center;
  }

  .team-member__photo {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .team-member__content {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: var(--spacing-sm);

    @include mx.up(lg) {
      padding: var(--spacing-md);
    }
  }

  .team-member__name {
    margin-bottom: var(--spacing-xs);
    font-size: 1.25rem;
  }

  .team-member__roles {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    padding: 0;
    list-style: none;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
</style>
