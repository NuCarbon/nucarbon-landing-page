---
// Small monospace label, e.g. "Em breve" or a biome name.
interface Props {
  tone?: 'neutral' | 'primary';
  class?: string;
}

const { tone = 'neutral', class: className } = Astro.props;
---

<span class:list={['badge', `badge--${tone}`, className]}>
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-xs);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.4;
    white-space: nowrap;
  }

  .badge--neutral {
    background: var(--color-surface-muted);
    color: var(--color-text-muted);
  }

  .badge--primary {
    background: var(--color-primary-soft);
    color: var(--color-primary-dark);
  }
</style>
