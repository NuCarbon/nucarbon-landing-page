---
// Visible breadcrumb trail plus the matching schema.org BreadcrumbList.
// The last item is the current page; give it an href so search engines get its URL.
import JsonLd from './JsonLd.astro';
import { breadcrumbListJsonLd, type BreadcrumbItem } from '../../lib/structured-data';

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
const structuredData = breadcrumbListJsonLd(items, Astro.site ?? Astro.url);
---

<nav class="breadcrumbs" aria-label="Caminho">
  <ol>
    {items.map((item, index) => {
      const current = index === items.length - 1;
      return (
        <li>
          {current || !item.href ? (
            <span aria-current={current ? 'page' : undefined}>{item.label}</span>
          ) : (
            <a href={item.href}>{item.label}</a>
          )}
          {!current && (
            <span class="breadcrumbs__separator" aria-hidden="true">
              ›
            </span>
          )}
        </li>
      );
    })}
  </ol>
</nav>
<JsonLd data={structuredData} />
<style>
  .breadcrumbs {
    margin-bottom: var(--spacing-md);
    font-size: 0.875rem;
  }

  ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2xs);
    list-style: none;
  }

  li {
    display: inline-flex;
    gap: var(--spacing-2xs);
    min-width: 0;
    color: var(--color-text-muted);
  }

  a {
    color: var(--color-primary);
    font-weight: 600;
  }

  a:hover {
    color: var(--color-primary-dark);
    text-decoration: underline;
  }

  .breadcrumbs__separator {
    color: var(--color-text-subtle);
  }
</style>
