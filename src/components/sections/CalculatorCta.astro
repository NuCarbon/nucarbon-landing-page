---
// Landing band that sends visitors to the carbon footprint calculator.
import CTA from '../ui/CTA.astro';
---

<section class="section" data-track-location="landing_cta_band">
  <div class="container">
    <CTA
      title="Qual é a sua pegada de carbono?"
      subtitle="Responda 6 perguntas rápidas sobre seus hábitos e descubra quanto CO₂ você emite por ano e como reduzir."
      label="Calcular minha pegada"
      href="/calculadora"
    />
  </div>
</section>
