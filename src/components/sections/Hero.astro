---
import { getImage } from 'astro:assets';
import forestHero from '../../images/forest-hero-2.jpg';
import Button from '../ui/Button.astro';
import { site } from '../../data/site';

// The source photo is 8064px wide; ship resized WebP backgrounds instead.
const [small, large] = await Promise.all([
  getImage({ src: forestHero, width: 960, format: 'webp' }),
  getImage({ src: forestHero, width: 1920, format: 'webp' }),
]);
const heroImageSmall = `url(${small.src})`;
const heroImageLarge = `url(${large.src})`;
---

<section class="hero" data-track-location="landing_hero">
  <div class="container">
    <h1 class="hero__title">{site.name}</h1>
    <p class="hero__subtitle">
      Soluções sustentáveis em créditos de carbono e projetos agroflorestais
    </p>
    <div class="hero__actions">
      <Button href="#solucoes" variant="primary-inverse" size="lg">
        Conheça Nossas Soluções
      </Button>
      <Button href="#contato" variant="outline-inverse" size="lg">
        Entre em Contato
      </Button>
    </div>
    <p class="hero__calculator">
      <a href="/calculadora" class="hero__calculator-link">
        Quanto CO₂ você emite? Calcule sua pegada em 2 minutos <span aria-hidden="true">→</span>
      </a>
    </p>
  </div>
</section>

<style lang="scss" define:vars={{ heroImageSmall, heroImageLarge }}>
  @use '../../styles/mixins' as mx;

  .hero {
    --hero-image: var(--heroImageSmall);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    min-height: 100svh;
    padding: calc(var(--header-height) + var(--spacing-2xl)) 0 var(--spacing-2xl);
    background:
      linear-gradient(180deg, var(--color-primary-dark) 0%, var(--color-surface) 100%),
      var(--hero-image) center / cover;
    background-blend-mode: multiply;
    color: var(--color-on-dark);
    text-align: center;

    @include mx.up(md) {
      --hero-image: var(--heroImageLarge);
    }
  }

  .hero__title {
    margin-bottom: var(--spacing-md);
    color: var(--color-on-dark);
    font-size: clamp(4rem, 8vw, 8rem);
  }

  .hero__subtitle {
    max-width: 650px;
    margin: 0 auto var(--spacing-xl);
    color: var(--color-on-dark);
    font-size: clamp(1.25rem, 2.5vw, 2rem);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--spacing-md);
  }

  .hero__calculator {
    margin: var(--spacing-lg) 0 0;
    font-size: 1.0625rem;
  }

  .hero__calculator-link {
    color: var(--color-on-dark);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--color-on-dark-muted);
    text-underline-offset: 0.25em;

    &:hover {
      color: var(--color-on-dark-muted);
    }
  }
</style>
