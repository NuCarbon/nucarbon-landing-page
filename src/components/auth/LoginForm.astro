---
// Google sign-in card. Behaviour: initializeLoginForm in scripts/login-modal.ts.
import Button from '../ui/Button.astro';

interface Props {
  /** 1 when the form is the page's main content (/entrar), 2 inside the login modal. */
  headingLevel?: 1 | 2;
  titleId?: string;
}

const { headingLevel = 2, titleId = 'login-title' } = Astro.props;
const Heading = `h${headingLevel}` as 'h1' | 'h2';
---

<section class="login-card" data-login-form aria-labelledby={titleId}>
  <p class="eyebrow">Sua jornada de impacto</p>
  <Heading id={titleId} class="login-card__title">
    Entre na Nucarbon
  </Heading>
  <p class="login-card__text">Continue com Google para entrar ou criar sua conta.</p>
  <Button variant="outline" size="lg" block data-google-sign-in>
    Continuar com Google
  </Button>
  <p class="login-card__error" data-login-error role="alert" hidden></p>
</section>

<style>
  .login-card {
    width: 100%;
    max-width: 30rem;
    padding: var(--spacing-xl) var(--spacing-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    text-align: center;
  }

  .login-card__title {
    margin-bottom: var(--spacing-xs);
    font-size: clamp(1.625rem, 4vw, 2rem);
  }

  .login-card__text {
    margin-bottom: var(--spacing-md);
  }

  .login-card__error {
    margin: var(--spacing-sm) 0 0;
    padding: var(--spacing-xs) var(--spacing-sm);
    border-radius: var(--radius-sm);
    background: var(--color-danger-soft);
    color: var(--color-danger);
    font-size: 0.875rem;
  }
</style>
