---
// Sign-in dialog opened by openLoginModal() (scripts/login-modal.ts) on any page.
import ModalCloseButton from '../ui/ModalCloseButton.astro';
import LoginForm from './LoginForm.astro';
---

<dialog class="login-modal" data-login-modal aria-labelledby="modal-login-title">
  <ModalCloseButton />
  <LoginForm headingLevel={2} titleId="modal-login-title" />
</dialog>

<script>
  import { initializeLoginModal } from '../../scripts/login-modal';

  initializeLoginModal();
</script>

<style>
  .login-modal {
    width: min(100% - 2 * var(--spacing-sm), 30rem);
    max-width: none;
    max-height: calc(100dvh - 2 * var(--spacing-sm));
    margin: auto;
    padding: 0;
    overflow: auto;
    border: 0;
    border-radius: var(--radius-lg);
    background: transparent;
  }

  .login-modal::backdrop {
    background: var(--color-overlay);
  }
</style>
