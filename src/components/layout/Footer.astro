---
import Logo from '../ui/Logo.astro';
import { contact, footerNav, site, solutionNav } from '../../data/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <Logo tone="inverse" />
        <p class="footer__tagline">{site.tagline}</p>
      </div>

      <nav aria-labelledby="footer-links-heading">
        <h2 id="footer-links-heading" class="footer__heading">
          Links
        </h2>
        <ul class="footer__list">
          {footerNav.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-labelledby="footer-solutions-heading">
        <h2 id="footer-solutions-heading" class="footer__heading">
          Soluções
        </h2>
        <ul class="footer__list">
          {solutionNav.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div>
        <h2 class="footer__heading">Contato</h2>
        <ul class="footer__list">
          <li>
            <a href={`mailto:${contact.email}`}>{contact.email}</a>
          </li>
          {contact.phones.map((phone) => (
            <li>
              <a href={phone.href}>{phone.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <p class="footer__bottom">
      &copy; {year} {site.name}. Todos os direitos reservados.
    </p>
  </div>
</footer>

<style lang="scss">
  @use '../../styles/mixins' as mx;

  .footer {
    padding: var(--spacing-2xl) 0 var(--spacing-lg);
    background-color: var(--color-primary-dark);
    color: var(--color-on-dark-muted);
  }

  .footer__grid {
    display: grid;
    gap: var(--spacing-xl);
    margin-bottom: var(--spacing-xl);

    @include mx.up(sm) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    @include mx.up(lg) {
      grid-template-columns: minmax(0, 2fr) repeat(3, minmax(0, 1fr));
    }
  }

  .footer__tagline {
    max-width: 22rem;
    margin: var(--spacing-sm) 0 0;
    color: var(--color-on-dark-muted);
  }

  .footer__heading {
    margin-bottom: var(--spacing-sm);
    color: var(--color-primary-tint);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer__list {
    display: grid;
    gap: var(--spacing-xs);
    padding: 0;
    list-style: none;

    a {
      color: var(--color-on-dark-muted);
      overflow-wrap: anywhere;

      &:hover {
        color: var(--color-on-dark);
        text-decoration: underline;
      }
    }
  }

  .footer__bottom {
    margin: 0;
    padding-top: var(--spacing-lg);
    border-top: 1px solid var(--color-on-dark-line);
    color: var(--color-on-dark-muted);
    font-size: 0.875rem;
    text-align: center;
  }
</style>
