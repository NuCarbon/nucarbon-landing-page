---
import HeaderAccount from './HeaderAccount.astro';
import Logo from '../ui/Logo.astro';
import { mainNav, type NavLink } from '../../data/site';

interface Props {
  /** Starts transparent over a dark hero and turns solid once the page scrolls. */
  transparent?: boolean;
}

const { transparent = false } = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';

/** Section links (`/#...`) are never current; `/projetos/x` marks "Projetos" as its ancestor. */
function ariaCurrent({ href }: NavLink): 'page' | 'true' | undefined {
  if (href.includes('#')) return undefined;
  if (currentPath === href) return 'page';
  return currentPath.startsWith(`${href}/`) ? 'true' : undefined;
}
---

<header
  class:list={['header', { 'header--transparent': transparent }]}
  data-header
  data-transparent={transparent ? '' : undefined}
>
  <div class="container header__inner">
    <Logo />

    <nav class="header__nav" aria-label="Navegação principal">
      <button
        type="button"
        class="header__toggle"
        aria-controls="site-menu"
        aria-expanded="false"
        aria-label="Abrir menu"
        data-menu-toggle
      >
        <span class="header__toggle-bar"></span>
        <span class="header__toggle-bar"></span>
        <span class="header__toggle-bar"></span>
      </button>

      <div id="site-menu" class="header__menu" data-menu>
        <ul class="header__links">
          {mainNav.map((link) => (
            <li>
              <a href={link.href} class="header__link" aria-current={ariaCurrent(link)}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        <HeaderAccount />
      </div>
    </nav>
  </div>
</header>

<script>
  import '../../scripts/site/header';
</script>

<style lang="scss">
  @use '../../styles/mixins' as mx;

  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-header);
    background-color: var(--color-surface);
    box-shadow: var(--shadow-header);
    transition:
      background-color var(--transition-base),
      box-shadow var(--transition-base),
      transform var(--transition-base);
  }

  .header--hidden {
    box-shadow: none;
    transform: translateY(-100%);
  }

  .header--transparent {
    --logo-color: var(--color-on-dark);
    background-color: transparent;
    box-shadow: none;
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
    min-height: var(--header-height);
  }

  .header__links {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .header__link {
    color: var(--color-text);
    font-weight: 600;

    &:hover,
    &[aria-current] {
      color: var(--color-primary);
    }
  }

  .header__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 4px;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: calc(-1 * var(--spacing-xs));
    border: 0;
    border-radius: var(--radius-sm);
    background: none;
    color: var(--color-text);
    cursor: pointer;

    .header--transparent & {
      color: var(--color-on-dark);
    }
  }

  .header__toggle-bar {
    width: 1.5rem;
    height: 2px;
    border-radius: var(--radius-pill);
    background-color: currentColor;
    transition:
      transform var(--transition-base),
      opacity var(--transition-base);

    [aria-expanded='true'] > &:nth-child(1) {
      transform: translateY(6px) rotate(45deg);
    }

    [aria-expanded='true'] > &:nth-child(2) {
      opacity: 0;
    }

    [aria-expanded='true'] > &:nth-child(3) {
      transform: translateY(-6px) rotate(-45deg);
    }
  }

  @include mx.down(xl) {
    .header__toggle {
      display: flex;
    }

    .header__menu {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      max-height: calc(100vh - var(--header-height));
      overflow-y: auto;
      padding: var(--spacing-xs) var(--container-gutter) var(--spacing-md);
      background-color: var(--color-surface);
      box-shadow: var(--shadow-header);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-0.5rem);
      transition:
        opacity var(--transition-base),
        transform var(--transition-base),
        visibility var(--transition-base);

      .header--menu-open & {
        opacity: 1;
        visibility: visible;
        transform: none;
      }
    }

    .header__links {
      flex-direction: column;
      margin-bottom: var(--spacing-md);
    }

    .header__link {
      display: block;
      padding: 0.75rem 0;
      border-bottom: 1px solid var(--color-border);
    }
  }

  @include mx.up(xl) {
    .header__menu {
      display: flex;
      align-items: center;
      gap: var(--spacing-lg);
    }

    .header__links {
      gap: var(--spacing-lg);
    }

    .header--transparent .header__link {
      color: var(--color-on-dark);

      &:hover,
      &[aria-current] {
        color: var(--color-on-dark-muted);
      }
    }
  }
</style>
