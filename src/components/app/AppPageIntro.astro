---
interface Props {
  description: string;
  eyebrow?: string;
}

const { description, eyebrow } = Astro.props;
---

<header class="page-intro">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1 class="page-intro__title">
    <slot />
  </h1>
  <p class="page-intro__description">{description}</p>
</header>
