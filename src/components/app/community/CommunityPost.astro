---
// Rendered inside a <template>; filled by scripts/app/community-feed.ts.
---

<article class="community-post">
  <header class="community-post__header">
    <span class="community-post__avatar" data-post-avatar aria-hidden="true"></span>
    <div class="community-post__byline">
      <strong data-post-author></strong>
      <time class="community-post__time" data-post-time></time>
    </div>
  </header>
  <p class="community-post__body" data-post-body></p>
  <footer class="community-post__footer">
    <span data-post-reactions></span>
    <span data-post-comments></span>
  </footer>
</article>
