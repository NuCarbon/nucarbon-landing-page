---
import type { ImpactMetric as ImpactMetricData } from '../../../types/app';
import ImpactMetric from './ImpactMetric.astro';

interface Props {
  metrics?: ImpactMetricData[];
}

const { metrics = [] } = Astro.props;
---

<app-impact-metrics class="metric-grid">
  {metrics.map((metric) => <ImpactMetric metric={metric} />)}

  <template data-metric-template>
    <ImpactMetric />
  </template>
</app-impact-metrics>

<script>
  import { formatMetric } from '../../../scripts/app/format';
  import type { ImpactMetric } from '../../../types/app';

  class ImpactMetrics extends HTMLElement {
    set metrics(metrics: ImpactMetric[]) {
      const template = this.querySelector<HTMLTemplateElement>(
        'template[data-metric-template]',
      );

      if (!template) return;

      this.querySelectorAll(':scope > .metric-card').forEach((card) => card.remove());

      const cards = metrics.map((metric) => {
        const fragment = template.content.cloneNode(true) as DocumentFragment;
        const display = formatMetric(metric);
        const icon = fragment.querySelector<HTMLElement>('[data-metric-icon]');
        const label = fragment.querySelector<HTMLElement>('[data-metric-label]');
        const value = fragment.querySelector<HTMLElement>('[data-metric-value]');

        if (icon) icon.textContent = display.icon;
        if (label) label.textContent = display.label;
        if (value) value.textContent = display.value;

        return fragment;
      });

      this.append(...cards);
    }
  }

  if (!customElements.get('app-impact-metrics')) {
    customElements.define('app-impact-metrics', ImpactMetrics);
  }
</script>
