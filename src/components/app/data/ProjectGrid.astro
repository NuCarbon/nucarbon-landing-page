---
import type { Project } from '../../../types/app';
import ProjectCard from './ProjectCard.astro';

interface Props {
  projects?: Project[];
}

const { projects = [] } = Astro.props;
---

<app-project-grid class="project-grid">
  {projects.map((project) => <ProjectCard project={project} />)}

  <template data-project-template>
    <ProjectCard />
  </template>
</app-project-grid>

<script>
  import { biomeLabels, statusLabels, formatArea, formatProgress, formatLocation, projectImageClass } from '../../../scripts/app/format';
  import type { Project } from '../../../types/app';

  function setText(root: ParentNode, selector: string, value: string): void {
    const target = root.querySelector<HTMLElement>(selector);
    if (target) target.textContent = value;
  }
  class ProjectGrid extends HTMLElement {
    set projects(projects: Project[]) {
      const template = this.querySelector<HTMLTemplateElement>(
        'template[data-project-template]',
      );

      if (!template) return;

      this.querySelectorAll(':scope > .project-card').forEach((card) => card.remove());

      const cards = projects.map((project) => {
        const fragment = template.content.cloneNode(true) as DocumentFragment;
        const image = fragment.querySelector<HTMLElement>('[data-project-image]');
        const progressBar = fragment.querySelector<HTMLElement>(
          '[data-project-progress-bar]',
        );
        const progress = Math.min(100, Math.max(0, project.restorationProgress * 100));

        if (image) image.className = projectImageClass(project.biome);
        if (progressBar) progressBar.style.width = `${progress}%`;

        setText(fragment, '[data-project-biome]', biomeLabels[project.biome]);
        setText(fragment, '[data-project-location]', formatLocation(project.location));
        setText(fragment, '[data-project-name]', project.name);
        setText(
          fragment,
          '[data-project-hectares]',
          formatArea(project.areaHectares),
        );
        setText(fragment, '[data-project-progress]', formatProgress(project.restorationProgress));
        setText(fragment, '[data-project-status]', statusLabels[project.status]);

        return fragment;
      });

      this.append(...cards);
    }
  }

  if (!customElements.get('app-project-grid')) {
    customElements.define('app-project-grid', ProjectGrid);
  }
</script>
