---
import { formatDate, formatReactions, formatComments } from '../../../scripts/app/format';
import type { CommunityPost } from '../../../types/app';

interface Props {
  post?: CommunityPost;
}

const { post } = Astro.props;
---

<article class="community-post">
  <header>
    <div class="post-avatar" data-post-avatar>{post?.author.displayName.charAt(0)}</div>
    <div>
      <strong data-post-author>{post?.author.displayName}</strong>
      <small data-post-timestamp>{post && formatDate(post.createdAt)}</small>
    </div>
  </header>
  <p data-post-body>{post?.body}</p>
  <footer>
    <span data-post-reactions>{post && formatReactions(post.reactions)}</span>
    <span data-post-comments>{post && formatComments(post.commentCount)}</span>
  </footer>
</article>
