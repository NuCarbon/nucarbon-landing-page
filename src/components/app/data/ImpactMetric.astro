---
import { formatMetric } from '../../../lib/format';
import type { ImpactMetric } from '../../../types/app';

interface Props {
  metric?: ImpactMetric;
}

const { metric } = Astro.props;
const display = metric && formatMetric(metric);
---

<article class="metric-card">
  <span data-metric-icon>{display?.icon}</span>
  <div>
    <p data-metric-label>{display?.label}</p>
    <strong data-metric-value>{display?.value}</strong>
  </div>
</article>
