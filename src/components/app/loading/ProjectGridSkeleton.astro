---
import Skeleton from '../../ui/Skeleton.astro';

interface Props {
  count?: number;
}

const { count = 3 } = Astro.props;
---

<div class="project-grid" aria-hidden="true">
  {
    Array.from({ length: count }).map(() => (
      <article class="project-card skeleton-card">
        <Skeleton height="135px" radius="0" variant="block" />
        <div class="project-content skeleton-stack">
          <div class="skeleton-row">
            <Skeleton width="6rem" height="1.1rem" />
            <Skeleton width="7.5rem" height="1.1rem" />
          </div>
          <Skeleton width="82%" height="1rem" />
          <Skeleton width="62%" height="0.8rem" />
          <Skeleton width="100%" height="0.4rem" radius="100px" />
          <Skeleton width="5rem" height="0.7rem" />
        </div>
      </article>
    ))
  }
</div>
