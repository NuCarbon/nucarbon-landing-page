---
import AppPageIntro from '../AppPageIntro.astro';
import CommunityFeed from '../data/CommunityFeed.astro';
import AppError from '../data/AppError.astro';
import CommunityFeedSkeleton from '../loading/CommunityFeedSkeleton.astro';
import LoadingState from '../../ui/LoadingState.astro';
---

<app-community-view class="app-page" aria-live="polite" aria-busy="true">
  <AppPageIntro
    overline="Comunidade Nucarbon"
    description="Acompanhe as atualizações de quem protege e restaura nossos biomas."
  >
    Impacto que cresce junto
  </AppPageIntro>

  <LoadingState label="Carregando publicações da comunidade">
    <CommunityFeedSkeleton />
  </LoadingState>

  <div data-app-content hidden>
    <CommunityFeed />
  </div>

  <template data-app-error>
    <AppError />
  </template>
</app-community-view>

<script>
  import { AppDataView } from '../../../scripts/app/data-view';
  import type { CommunityPost, CommunityResponse } from '../../../types/app';

  type CommunityFeedElement = HTMLElement & { posts: CommunityPost[] };

  class CommunityView extends AppDataView<CommunityResponse> {
    protected readonly endpoint = '/api/community';

    protected async renderData(data: CommunityResponse): Promise<void> {
      await customElements.whenDefined('app-community-feed');

      const feed = this.querySelector<CommunityFeedElement>('app-community-feed');
      if (feed) feed.posts = data.posts;
    }
  }

  if (!customElements.get('app-community-view')) {
    customElements.define('app-community-view', CommunityView);
  }
</script>
