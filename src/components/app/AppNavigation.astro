---
// One navigation for every viewport: a bottom bar on small screens, a sidebar from `lg` up.
// On public pages, AppLayout points guests' `requiresAuth` links to /entrar (data-guest-href).
import { loginPath } from '../../lib/urls';

interface Props {
  active: 'dashboard' | 'projects' | 'community';
}

const { active } = Astro.props;

// Icon paths share a 24×24 stroke grid and inherit the link color.
const items = [
  {
    key: 'dashboard',
    label: 'Painel',
    href: '/app',
    requiresAuth: true,
    icon: '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
  },
  {
    key: 'projects',
    label: 'Projetos',
    href: '/projetos',
    requiresAuth: false,
    icon: '<path d="M12 2.5 5.5 11.5H9L5 17.5h14l-4-6h3.5z"/><path d="M12 17.5v4"/>',
  },
  {
    key: 'community',
    label: 'Comunidade',
    href: '/app/comunidade',
    requiresAuth: true,
    icon: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M16 4.6a3.5 3.5 0 0 1 0 6.8"/><path d="M18 14.2a6.5 6.5 0 0 1 3.5 5.8"/>',
  },
] as const;

const lockIcon =
  '<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>';
---

<nav class="app-nav" aria-label="Navegação da conta">
  <ul class="app-nav__list">
    {items.map((item) => (
      <li>
        <a
          class="app-nav__link"
          href={item.href}
          aria-current={item.key === active ? 'page' : undefined}
          data-user-href={item.requiresAuth ? item.href : undefined}
          data-guest-href={item.requiresAuth ? loginPath(item.href) : undefined}
        >
          <svg
            class="app-nav__icon"
            viewBox="0 0 24 24"
            aria-hidden="true"
            focusable="false"
            set:html={item.icon}
          />
          {item.label}
          {item.requiresAuth && (
            <span class="app-nav__lock" data-auth-guest hidden>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={lockIcon} />
              <span class="visually-hidden">(requer login)</span>
            </span>
          )}
        </a>
      </li>
    ))}
  </ul>
</nav>
